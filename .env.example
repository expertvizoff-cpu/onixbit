DOMAIN=onixbit.ru
ACME_EMAIL=expert@onixbit.ru
ONIXBIT_IMAGE_TAG=local

NEXT_PUBLIC_YANDEX_METRIKA_ID=88710867

# Server-only delivery for the first-party lead modal. Never prefix with
# NEXT_PUBLIC_ and never commit a real webhook. The URL ends with /rest/<user>/<token>/.
BITRIX24_WEBHOOK_URL=
# Optional only for an explicitly approved self-hosted/custom Bitrix24 domain.
BITRIX24_ALLOWED_HOST=
BITRIX24_SOURCE_ID=WEBFORM
BITRIX24_DEAL_CATEGORY_ID=
BITRIX24_DEAL_STAGE_ID=
BITRIX24_ASSIGNED_BY_ID=
LEAD_ALLOWED_ORIGINS=https://onixbit.ru

# Optional Sentry monitoring. Leave empty to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Zvukogram text-to-speech API. Keep real values in .env or .env.local.
ZVUKOGRAM_EMAIL=
ZVUKOGRAM_TOKEN=
ZVUKOGRAM_VOICE=
ZVUKOGRAM_SPEED=0.92
ZVUKOGRAM_PITCH=-1
ZVUKOGRAM_PAUSE_SENTENCE=350
ZVUKOGRAM_PAUSE_PARAGRAPH=650
ZVUKOGRAM_VOLUME=100
