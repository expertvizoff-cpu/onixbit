DOMAIN=onixbit.ru
ACME_EMAIL=expert@onixbit.ru
ONIXBIT_IMAGE_TAG=local

NEXT_PUBLIC_YANDEX_METRIKA_ID=88710867

# Optional Sentry monitoring. Leave empty to keep Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Zvukogram text-to-speech API. Keep real values in .env or .env.local.
ZVUKOGRAM_EMAIL=
ZVUKOGRAM_TOKEN=
ZVUKOGRAM_VOICE=
ZVUKOGRAM_SPEED=0.92
ZVUKOGRAM_PITCH=-1
ZVUKOGRAM_PAUSE_SENTENCE=350
ZVUKOGRAM_PAUSE_PARAGRAPH=650
ZVUKOGRAM_VOLUME=100
